[Unit]
Description=Cloudflare quick tunnel for Meeting Scheduler
After=network-online.target meeting-scheduler.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
